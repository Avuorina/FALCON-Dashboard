<UserControl x:Class="FALCONDashboard.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="ChatScroll">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Prompt}" FontFamily="{StaticResource MonoFont}"
                                       FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource LabelDimBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sender}" Value="隼">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource UiFont}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="20" Background="#0dffffff" BorderThickness="1" BorderBrush="#14ffffff">
                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="14"
                         Padding="14,10" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </Border>

            <Border Grid.Column="1" Width="42" Height="42" Margin="10,0,0,0" CornerRadius="21"
                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1">
                <Button Content="&#10148;" Command="{Binding SendCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                   FontFamily="{StaticResource UiFont}" FontSize="11" Margin="0,58,0,0"/>
    </Grid>
</UserControl>