<Application x:Class="FALCONDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ★カラートークン★ FALCON本体(PWA)と揃えた配色。ここが唯一の出どころ -->
        <SolidColorBrush x:Key="BgBrush" Color="#0a0c10"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#ff8a3d"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#59ff8a3d"/>   <!-- 35%透過 -->
        <SolidColorBrush x:Key="AccentFaintBrush" Color="#14ff8a3d"/> <!-- 8%透過 -->
        <SolidColorBrush x:Key="BorderBrush2" Color="#2eff8a3d"/>     <!-- 18%透過 -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#eef1f6"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#c3c9d4"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#5c6474"/>
        <SolidColorBrush x:Key="LabelDimBrush" Color="#8a93a3"/>

        <!-- ★フォントトークン★ 無ければ代替フォントに落ちる(カンマ区切りでフォールバック) -->
        <FontFamily x:Key="UiFont">Inter, Segoe UI Variable, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas</FontFamily>

        <!-- ★タブの見た目★ WPF標準のフォルダタブ風を捨てて、下線インジケータ方式にする -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource LabelDimBrush}"/>
            <Setter Property="Padding" Value="4,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="0,0,24,0">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="20,0,20,0"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>